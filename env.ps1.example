# Copiez ce fichier en env.ps1 (déjà dans .gitignore, ne sera jamais commité)
# et remplacez les valeurs par vos identifiants réels — les mêmes que dans env.bash.

$env:SHOPIFY_CLIENT_ID = "REPLACE_ME"
$env:SHOPIFY_CLIENT_SECRET = "REPLACE_ME"
# $env:SHOPIFY_SHOP = "epiphanieboutique"  # optionnel, valeur par défaut déjà correcte
$env:SNOWFLAKE_ACCOUNT = "XXXXX-XXXXX"
$env:SNOWFLAKE_USER = "XXXXX"
$env:SNOWFLAKE_PRIVATE_KEY = Get-Content -Raw "chemin\vers\ta_cle_privee.p8"
$env:SNOWFLAKE_ROLE = "xxxxxxxxxxx"
$env:SNOWFLAKE_WAREHOUSE = "XXXXX"
